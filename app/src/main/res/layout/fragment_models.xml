<?xml version="1.0" encoding="utf-8"?>
<!-- Model management (Spec §4): state-aware controls for Gemma;
     Coder Helper: user imports / deletes the file here; Gemma loads and unloads it automatically. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            app:tint="@color/text2" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Models"
            android:textColor="@color/text1"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Gemma card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card_16"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icon_box">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_sparkle"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gemma 4 E4B IT"
                            android:textColor="@color/text1"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Master brain — orchestrator, planner, validator"
                            android:textColor="@color/text3"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/badgeGemmaState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/active_badge"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="NOT IMPORTED"
                        android:textColor="@color/accent"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textGemmaMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text2"
                    android:textSize="12sp"
                    android:text="Import the Gemma 4 E4B IT `.litertlm` model. Without a loaded model the assistant cannot give real answers or write real code." />

                <ProgressBar
                    android:id="@+id/progressModel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textEngineStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text3"
                    android:textSize="11.5sp"
                    android:text="Engine: checking…" />

                <LinearLayout
                    android:id="@+id/rowModelButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/btnImport"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_primary_state"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="Import"
                        android:textColor="#FF08131F"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnLoad"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/glass_card_solid"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="Load"
                        android:textColor="@color/text1"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/btnUnload"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/glass_card_solid"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="Unload"
                        android:textColor="@color/text1"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/btnDelete"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/glass_card_solid"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="Delete"
                        android:textColor="#FFFF7B72"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Coder Helper card: import + delete (load/unload is automatic) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card_16"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/icon_box">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cube"
                            app:tint="@color/text2" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Coder Helper"
                            android:textColor="@color/text1"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Coding worker — Gemma loads and unloads it automatically"
                            android:textColor="@color/text3"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/badgeCoderState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/active_badge"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="IDLE"
                        android:textColor="@color/text2"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textCoderMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text3"
                    android:textSize="11.5sp"
                    android:text="Import a small coding model (`.gguf`, or `.litertlm` when its runtime supports it). Gemma will load it only when a coding task needs it, and unload it afterwards." />

                <ProgressBar
                    android:id="@+id/progressCoder"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/btnCoderImport"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_primary_state"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="Import"
                        android:textColor="#FF08131F"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCoderDelete"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/glass_card_solid"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="Delete"
                        android:textColor="#FFFF7B72"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card_16"
                android:padding="16dp"
                android:text="Developer diagnostics →"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
