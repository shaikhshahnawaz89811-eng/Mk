<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="2dp">

    <FrameLayout
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/avatar_circle">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <!-- Claude/ChatGPT style: assistant text is plain, full width, no bubble -->
        <TextView
            android:id="@+id/textMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text1"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.25"
            android:text="Here's a clean and simple todo app using React." />

        <LinearLayout
            android:id="@+id/fileCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_card_16"
            android:padding="10dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/icon_box">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_file"
                    app:tint="@color/accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="14dp">

                <TextView
                    android:id="@+id/textFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TodoApp.jsx"
                    android:textColor="@color/text1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textFileType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="React"
                    android:textColor="@color/text3"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
