<?xml version="1.0" encoding="utf-8"?>
<!-- Inline interruption card (Spec §13 approval card, §14 interruptions):
     answers what will happen, why, and the meaningful choices. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="2dp">

    <FrameLayout
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/avatar_circle">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield"
            app:tint="@color/accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:background="@drawable/glass_card_16"
        android:padding="14dp">

        <TextView
            android:id="@+id/textApprovalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Need your input"
            android:textColor="@color/text1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textApprovalBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text2"
            android:textSize="12.5sp"
            android:lineSpacingMultiplier="1.25"
            android:text="…" />

        <LinearLayout
            android:id="@+id/approvalButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnOption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary_state"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Allow once"
                android:textColor="#FF08131F"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/glass_card_solid"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Deny"
                android:textColor="@color/text1"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnOption3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/glass_card_solid"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Skip"
                android:textColor="@color/text1"
                android:textSize="12.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/textDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text3"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
